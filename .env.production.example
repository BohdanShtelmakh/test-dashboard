# Copy to .env.production at repository root, then replace every placeholder.
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# URL-encode special characters in the password when constructing this URL.
DATABASE_URL=postgresql://dashboard:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/dashboard
API_PORT=3000
API_HOST_PORT=3000
CORS_ORIGIN=https://dashboard.example.com

# Runtime limits; tools run one at a time, separately from normal services.
# Memory and memory+swap limits match, preventing container swap usage.
API_CPUS=0.5
API_MEMORY=384m
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=384m
TOOLS_CPUS=0.5
TOOLS_MEMORY=384m
# Rotated stdout/stderr logs per container (not a database disk quota).
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Copy to .env.production at repository root, then replace every placeholder.
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# URL-encode special characters in the password when constructing this URL.
DATABASE_URL=postgresql://dashboard:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/dashboard
API_PORT=3000
API_HOST_PORT=3000
CORS_ORIGIN=https://dashboard.example.com

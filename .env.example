# Docker development settings. Host-run apps use apps/api/.env and apps/web/.env.
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_PORT=5432
API_PORT=3000
API_HOST_PORT=3000
PGWEB_PORT=8081
DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard
PGWEB_DATABASE_URL=postgres://dashboard:dashboard@postgres:5432/dashboard?sslmode=disable
CORS_ORIGIN=http://localhost:5173
